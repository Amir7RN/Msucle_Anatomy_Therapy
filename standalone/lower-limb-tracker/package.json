{
  "name": "@zeva/lower-limb-tracker",
  "version": "1.0.0",
  "description": "Real-time lower-limb (ankle/shank) pose tracking, live calibration, and recording — extracted from the Zeva Health platform for third-party integration.",
  "type": "module",
  "main": "dist/lower-limb-tracker.esm.js",
  "module": "dist/lower-limb-tracker.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/lower-limb-tracker.esm.js"
    }
  },
  "files": ["dist", "src", "README.md", "SYNC.md"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "build:bundle": "esbuild src/index.ts --bundle --format=esm --platform=browser --outfile=dist/lower-limb-tracker.esm.js",
    "build": "npm run build:types && npm run build:bundle"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35"
  },
  "devDependencies": {
    "esbuild": "^0.21.0",
    "typescript": "^5.4.5"
  },
  "license": "UNLICENSED"
}
