# Supabase Configuration
# Get these from your Supabase project settings (Authentication → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Remote Assessment (Live Call) TURN relay ────────────────────────────────
# WebRTC needs a TURN relay to connect peers on DIFFERENT networks. Without it,
# the call only works when both sides are on the same network. Pick ONE option:
#
# Option A (recommended, free): Metered Open Relay — sign up free at
#   https://dashboard.metered.ca/signup?tool=turnserver  (20 GB/mo free),
#   then copy your app subdomain + API key from the dashboard:
# VITE_METERED_DOMAIN=yourappname.metered.live
# VITE_METERED_API_KEY=your-metered-api-key
#
# Option B: any REST endpoint that returns an iceServers JSON array:
# VITE_TURN_CREDENTIAL_URL=https://yourappname.metered.live/api/v1/turn/credentials?apiKey=KEY
#
# Option C: your own coturn / static TURN (comma-separate multiple urls):
# VITE_TURN_URL=turn:your.turn.host:3478,turns:your.turn.host:5349
# VITE_TURN_USERNAME=your-turn-username
# VITE_TURN_CREDENTIAL=your-turn-password
